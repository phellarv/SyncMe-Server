# ==============================================================================
# SyncMe-Server Configuration
# ==============================================================================
# Copy this file to .env and adjust the values as needed:
#   cp .env.example .env

# Client keys live in a separate file, not in this one. Create them with:
#   mkdir -p keys && docker compose run --rm keys add <client-name>
# The server refuses to start without keys/keys.toml. SYNCME_API_KEY is no longer supported
# and makes the server refuse to start if it is still set.
# SYNCME_KEYS_FILE=/keys/keys.toml

# Server network binding host and port
HOST=0.0.0.0
PORT=8000

# Base directory for state database and server data (defaults to ./data)
DATA_DIR=./data

# Directory holding active synchronized files
# Designates the directory holding active synchronized files, separating it from the SQLite database directory in DATA_DIR.
STORAGE_DIR=./storage

# ------------------------------------------------------------------------------
# Optional Directory & Database Overrides
# ------------------------------------------------------------------------------
# If left unset or commented out, these default to paths inside DATA_DIR:
#
# Directory where deleted files are archived with timestamps (defaults to <DATA_DIR>/archive):
# ARCHIVE_DIR=./data/archive
#
# Path to the SQLite state database file (defaults to <DATA_DIR>/server_state.db):
# DB_PATH=./data/server_state.db

# ------------------------------------------------------------------------------
# Backups (`python -m app.cli backup`, or `docker compose run --rm backup backup`)
# ------------------------------------------------------------------------------
# Directory the archives are written to. Docker Compose mounts it at /backups in the `backup` service.
# Put it on another disk or sync it elsewhere: a backup on the same disk does not survive a disk failure.
# BACKUP_DIR=./backups
#
# Number of backups to keep in BACKUP_DIR; older ones are deleted after a new backup is verified. 0 keeps all.
BACKUP_KEEP=7
